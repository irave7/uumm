#!/bin/zsh
# 兼容 Snug 的本地远控诊断入口。
set -euo pipefail
cd "${0:A:h}/.."
case "${1:-help}" in
  remote-check)
    shift
    swift build --product uumm
    "$(swift build --show-bin-path)/uumm" --check-remote "$@"
    ;;
  check|app) exec scripts/uumm "$1" ;;
  *) print 'uumm 用 scripts/uumm check | app | dmg；原 Snug 的发版和下载源操作不在此 fork 中。' ;;
esac
